# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://docnmblhtvpohjpwmjka.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Solo del lado servidor. NUNCA la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- HubSpot ----
# Token de App Privada. Scopes necesarios:
#   crm.objects.deals.read · crm.objects.owners.read
#   crm.schemas.deals.read · crm.objects.contacts.read
HUBSPOT_TOKEN=pat-na1-xxxxxxxx

# "default" = todos los pipelines. Pon el ID si quieres filtrar solo uno.
HUBSPOT_PIPELINE_ID=default

# ---- Cron ----
# Cadena larga y aleatoria. Vercel la manda como Bearer en cada corrida.
# Genera una con:  openssl rand -base64 32
CRON_SECRET=

# ---- Propiedades personalizadas de HubSpot ----
# Estos son los nombres REALES del portal de PIXEL.play; ya vienen como valor
# por omisión en el código. Solo llénalos si alguna se renombra.
# HUBSPOT_PROP_CLASIFICACION=clasificacion_de_lead_cliente__prueba_gab_
# HUBSPOT_PROP_ORIGEN=origen_del_lead
# HUBSPOT_PROP_CATEGORIA_CIERRE=categoria_de_cierre
# HUBSPOT_PROP_MOTIVO_PERDIDA=motivo_de_perdida_o_diferimiento__clonada_
# HUBSPOT_PROP_FECHA_REACTIVACION=fecha_de_reactivacion
# HUBSPOT_PROP_TIPO_NEGOCIO=tipo_de_negocio__prueba_gab_
# HUBSPOT_PROP_FECHA_EVENTO=fecha_de_inicio_del_evento
